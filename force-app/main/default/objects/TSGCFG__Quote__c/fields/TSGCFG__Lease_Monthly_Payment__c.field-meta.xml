<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TSGCFG__Lease_Monthly_Payment__c</fullName>
    <deprecated>false</deprecated>
    <description>Monthly Leasing Payment based on (Total Hardware + Software) * Leasing Rate</description>
    <formula>IF (BLANKVALUE(TSGCFG__Leasing_Rate_Overrride__c,0)=0, 
   TSGCFG__Total_Equipment_Lease__c *  TSGCFG__Leasing_Rate_Factor__c, 
   TSGCFG__Total_Equipment_Lease__c *  TSGCFG__Leasing_Rate_Overrride__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Monthly Leasing Payment based on (Total Hardware + Software) * Leasing Rate</inlineHelpText>
    <label>Equipment Monthly Payment</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
