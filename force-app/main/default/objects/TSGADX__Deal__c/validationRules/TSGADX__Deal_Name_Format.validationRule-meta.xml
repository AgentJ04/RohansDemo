<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TSGADX__Deal_Name_Format</fullName>
    <active>false</active>
    <description>Validates that a deal contains a hyphen as a way of enforcing an “[Company] – [Description]” deal naming convention.</description>
    <errorConditionFormula>$Setup.TSGADX__ADX_Settings__c.TSGADX__Validation_Rules__c &amp;&amp; 
NOT($Setup.TSGADX__ADX_Settings__c.TSGADX__Executing__c) &amp;&amp;
FIND (&quot;-&quot; , Name ) = 0</errorConditionFormula>
    <errorDisplayField>Name</errorDisplayField>
    <errorMessage>Deal Name should use &quot;[Company] - [Description]&quot; format.</errorMessage>
</ValidationRule>
