<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TSGADX__Require_a_Proposal_Date_Negotiation</fullName>
    <active>false</active>
    <description>$Setup.TSGADX__ADX_Settings__c.TSGADX__Validation_Rules__c &amp;&amp; If the Sales Stage is &quot;Negotiation/Close&quot; then require a date be entered.</description>
    <errorConditionFormula>$Setup.TSGADX__ADX_Settings__c.TSGADX__Validation_Rules__c &amp;&amp; 
NOT($Setup.TSGADX__ADX_Settings__c.TSGADX__Executing__c) &amp;&amp;
ISPICKVAL( TSGADX__Sales_Stage__c, &quot;Negotiation/Close&quot;)&amp;&amp; ISBLANK( TSGADX__Proposal_Date__c ) &amp;&amp; ($RecordType.Name = &quot;Equipment Deals&quot;)</errorConditionFormula>
    <errorDisplayField>TSGADX__Proposal_Date__c</errorDisplayField>
    <errorMessage>Enter Date of Presented Proposal</errorMessage>
</ValidationRule>
