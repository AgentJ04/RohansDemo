<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TSGADX__Equipment_Won_Deal_Requires_Replace_Date</fullName>
    <active>false</active>
    <description>Require the Replacement Date when the deal is marked as won.</description>
    <errorConditionFormula>$Setup.TSGADX__ADX_Settings__c.TSGADX__Validation_Rules__c &amp;&amp; 
NOT($Setup.TSGADX__ADX_Settings__c.TSGADX__Executing__c) &amp;&amp;
ISPICKVAL(TSGADX__Sales_Stage__c , &quot;Won&quot;) &amp;&amp;
(ISBLANK(TSGADX__Replacement_Date__c) ||
  TSGADX__Replacement_Date__c &lt; (Today() + 360)) &amp;&amp;
$RecordType.Name = &quot;Equipment Deals&quot; &amp;&amp;
 $Setup.TSGADX__ADX_Settings__c.TSGADX__Won_Deal_to_New_Future_Deal__c</errorConditionFormula>
    <errorDisplayField>TSGADX__Replacement_Date__c</errorDisplayField>
    <errorMessage>When a Deal is won, you must enter the future replacement date in the &quot;Replacement Date&quot; field.</errorMessage>
</ValidationRule>
