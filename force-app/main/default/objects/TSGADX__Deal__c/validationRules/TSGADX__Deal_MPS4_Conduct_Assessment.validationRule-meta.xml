<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TSGADX__Deal_MPS4_Conduct_Assessment</fullName>
    <active>false</active>
    <description>Conduct Assessment requires DCS Install Date</description>
    <errorConditionFormula>$Setup.TSGADX__ADX_Settings__c.TSGADX__Validation_Rules__c &amp;&amp; 
NOT($Setup.TSGADX__ADX_Settings__c.TSGADX__Executing__c) &amp;&amp;
$RecordType.Name = &quot;MPS Deals&quot; &amp;&amp; ISPICKVAL(TSGADX__Sales_Stage__c , &quot;Conduct Assessment&quot;) &amp;&amp; ISBLANK( TSGADX__DSC_Installed__c )</errorConditionFormula>
    <errorDisplayField>TSGADX__DSC_Installed__c</errorDisplayField>
    <errorMessage>The sales stage of &quot;Conduct Assessment&quot; requires the DSC Installed date to be filled in.</errorMessage>
</ValidationRule>
