<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TSGADX__Require_a_Demo_Date</fullName>
    <active>false</active>
    <description>If the Sales Stage is &quot;Demonstration&quot; then require a date be entered.</description>
    <errorConditionFormula>$Setup.TSGADX__ADX_Settings__c.TSGADX__Validation_Rules__c &amp;&amp; 
NOT($Setup.TSGADX__ADX_Settings__c.TSGADX__Executing__c) &amp;&amp;
ISPICKVAL( TSGADX__Sales_Stage__c , &quot;Demonstration&quot;)&amp;&amp; ISBLANK( TSGADX__Demo_Date__c )</errorConditionFormula>
    <errorDisplayField>TSGADX__Demo_Date__c</errorDisplayField>
    <errorMessage>Enter Date of Demonstration</errorMessage>
</ValidationRule>
