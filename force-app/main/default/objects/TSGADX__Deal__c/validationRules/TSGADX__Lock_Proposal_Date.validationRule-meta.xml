<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TSGADX__Lock_Proposal_Date</fullName>
    <active>false</active>
    <description>Once a deal is SAVED the Proposal Date cannot be changed</description>
    <errorConditionFormula>$Setup.TSGADX__ADX_Settings__c.TSGADX__Validation_Rules__c &amp;&amp;
NOT($Setup.TSGADX__ADX_Settings__c.TSGADX__Executing__c) &amp;&amp;
 AND(
NOT( ISNEW( ) ),
ISCHANGED( TSGADX__Proposal_Date__c ))</errorConditionFormula>
    <errorDisplayField>TSGADX__Proposal_Date__c</errorDisplayField>
    <errorMessage>This field is locked - you cannot change the Proposal Date</errorMessage>
</ValidationRule>
