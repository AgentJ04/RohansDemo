<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TSGADX__Commission_Amount_less_then_Sales_Price</fullName>
    <active>false</active>
    <description>Commission Amount cannot be greater then the total Sales Price of the deal.</description>
    <errorConditionFormula>$Setup.TSGADX__ADX_Settings__c.TSGADX__Validation_Rules__c &amp;&amp; 
NOT($Setup.TSGADX__ADX_Settings__c.TSGADX__Executing__c) &amp;&amp;
TSGADX__Amount_for_Commission_Calculations__c   &gt;   TSGADX__Price__c</errorConditionFormula>
    <errorDisplayField>TSGADX__Amount_for_Commission_Calculations__c</errorDisplayField>
    <errorMessage>Commission Amount cannot be greater then the Total System w/ Services price.</errorMessage>
</ValidationRule>
