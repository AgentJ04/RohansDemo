<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TSGADX__Deal_MPS7_Negotiation_Close</fullName>
    <active>false</active>
    <description>Negotiation/Close requires Proposal date</description>
    <errorConditionFormula>$Setup.TSGADX__ADX_Settings__c.TSGADX__Validation_Rules__c &amp;&amp;
NOT($Setup.TSGADX__ADX_Settings__c.TSGADX__Executing__c) &amp;&amp;
 $RecordType.Name = &quot;MPS Deals&quot; &amp;&amp; ISPICKVAL(TSGADX__Sales_Stage__c , &quot;Negotiation/Close&quot;) &amp;&amp; ISBLANK( TSGADX__Proposal_Date__c )</errorConditionFormula>
    <errorDisplayField>TSGADX__Proposal_Date__c</errorDisplayField>
    <errorMessage>The sales stage of &quot;Negotiation/Close&quot; requires the Proposal date to be filled in.</errorMessage>
</ValidationRule>
