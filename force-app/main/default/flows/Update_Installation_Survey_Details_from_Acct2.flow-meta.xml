    </formulas>
    <formulas>
        <name>SurveyNotBlank_Bus</name>
        <dataType>Boolean</dataType>
        <expression>(NOT(ISBLANK(TEXT({!$Record.TSGADX__Business__r.TSGCFG__Stairs__c})))) || (NOT(ISBLANK(TEXT({!$Record.TSGADX__Business__r.TSGCFG__Elevator__c})))) || 
(NOT(ISBLANK(TEXT({!$Record.TSGADX__Business__r.TSGCFG__Loading_Liftgate_Needed__c}))))  ||  (NOT(ISBLANK(TEXT({!$Record.TSGADX__Business__r.TSGCFG__Loading_Zone__c})))) ||
(NOT(ISNULL({!$Record.TSGADX__Business__r.TSGCFG__Number_of_Flights__c}))) || (NOT(ISBLANK({!$Record.TSGCFG__Special_Delivery_Instructions__c})))</expression>
    </formulas>
    <formulas>
        <name>SurveyNotBlank_Install</name>
        <dataType>Boolean</dataType>
        <expression>(NOT(ISNULL(TEXT( {!$Record.TSGCFG__Stairs2__c})))) ||
(NOT(ISNULL(TEXT({!$Record.TSGCFG__Elevator2__c})))) || 
(NOT(ISNULL(TEXT({!$Record.TSGCFG__Loading_Liftgate_Needed__c}))))  ||  
(NOT(ISNULL(TEXT({!$Record.TSGCFG__Loading_Zone2__c})))) ||
(NOT(ISNULL({!$Record.TSGCFG__Number_of_Flights__c}))) || 
(NOT(ISNULL({!$Record.TSGCFG__Special_Delivery_Instructions__c})))</expression>
    </formulas>
    <formulas>
        <name>SurveyNotBlank_Ship</name>
        <dataType>Boolean</dataType>
        <expression>(NOT(ISBLANK(TEXT({!$Record.TSGCFG__Ship_To__r.TSGCFG__Stairs__c})))) || (NOT(ISBLANK(TEXT({!$Record.TSGCFG__Ship_To__r.TSGCFG__Elevator__c})))) || 
(NOT(ISBLANK(TEXT({!$Record.TSGCFG__Ship_To__r.TSGCFG__Loading_Liftgate_Needed__c}))))  ||
(NOT(ISBLANK(TEXT({!$Record.TSGCFG__Ship_To__r.TSGCFG__Loading_Zone__c})))) ||
(NOT(ISBLANK({!$Record.TSGCFG__Ship_To__r.TSGCFG__Number_of_Flights__c}))) || (NOT(ISBLANK({!$Record.TSGCFG__Ship_To__r.TSGCFG__Special_Delivery_Instructions__c})))</expression>
    </formulas>
