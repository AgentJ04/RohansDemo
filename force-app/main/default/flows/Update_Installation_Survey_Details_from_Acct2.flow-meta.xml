    <decisions>
        <name>Are_Flows_Enabled</name>
        <label>Are Flows Enabled?</label>
        <locationX>578</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>flows_enabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.TSGADX__ADX_Settings__c.TSGADX__Enable_Flow__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateInstallation</targetReference>
            </connector>
            <label>flows enabled?</label>
        </rules>
    </decisions>
    <decisions>
        <description>Record has ShipTo and survey fields not blank - use shipTo 
If no shipto or fields are blank use business details</description>
        <name>UpdateInstallation</name>
        <label>Update Installation</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>UpdateWithShipTo</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ShipToNotBlank</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>SurveyNotBlank_Ship</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Survey_Fields</targetReference>
            </connector>
            <label>Update With ShipTo</label>
        </rules>
        <rules>
            <name>UpdateWithBusiness</name>
            <conditionLogic>(3 AND 4) OR (1 AND 2)</conditionLogic>
            <conditions>
                <leftValueReference>ShipToNotBlank</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>SurveyNotBlank_Ship</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>AccountNotBlank</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>SurveyNotBlank_Bus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Survey_Fields_Bus</targetReference>
            </connector>
            <label>Update With Business</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>AccountNotBlank</name>
        <dataType>Boolean</dataType>
        <expression>(NOT(ISBLANK({!$Record.TSGADX__Business__c})))</expression>
    </formulas>
    <formulas>
        <description>To determine whether the record is new or the record is changed</description>
        <name>NewOrIsChanged</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW() || ISCHANGED({!$Record.LastModifiedDate})</expression>
    </formulas>
    <formulas>
        <name>NewOrIsChanged_Bus</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW() || ISCHANGED($Record.TSGADX__Business__c)</expression>
    </formulas>
    <formulas>
        <name>ShipToNotBlank</name>
