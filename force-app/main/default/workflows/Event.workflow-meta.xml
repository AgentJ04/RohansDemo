<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <fieldUpdates>
        <fullName>TSGADX__Update_Notes_from_Description</fullName>
        <description>Move 250 Characters from Description to Notes.</description>
        <field>TSGADX__Notes__c</field>
        <formula>Left(Description,250)</formula>
        <name>Update Notes from Description</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>TSGADX__Event Description to Notes</fullName>
        <actions>
            <name>TSGADX__Update_Notes_from_Description</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>If notes are blank then move 250 characters from description to notes.</description>
        <formula>$Setup.TSGADX__ADX_Settings__c.TSGADX__Enable_Workflow__c  &amp;&amp; ISBLANK (TSGADX__Notes__c)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
</Workflow>
