        <actions>
            <name>TSGADX__Clear_SIC</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>TSGADX__Create_New_Name_Inactive</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>TSGADX__Inactive_Check</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>TSGADX__Update_Deleted_Name</name>
            <type>FieldUpdate</type>
        </actions>
        <actions>
            <name>TSGADX__Update_Deleted_SIC</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>Inactive reason is selected. The &quot;Inactive&quot; check box is checked, the &quot;Business Name&quot; is copied to &quot;Deleted Name&quot;, Business Name is updated to &quot;Inactive*&quot;.</description>
        <formula>(ISCHANGED(TSGADX__Inactive_Reason__c) &amp;&amp;  ISBLANK(PRIORVALUE(TSGADX__Inactive_Reason__c)))  || (ISNEW() &amp;&amp;  (TSGADX__Inactive__c ||  NOT(ISPICKVAL(TSGADX__Inactive_Reason__c,&quot;&quot;) ) )  ) &amp;&amp; (Name &lt;&gt; &quot;Inactive *&quot;)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>TSGADX__Inactive Unchecked Business Request</fullName>
