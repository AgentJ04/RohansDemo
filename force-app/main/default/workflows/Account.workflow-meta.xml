        </actions>
        <actions>
            <name>TSGADX__Update_SIC</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>When Inactive check box is unchecked, the Business Name is copied from Deleted Name</description>
        <formula>$Setup.TSGADX__ADX_Settings__c.TSGADX__Enable_Workflow__c &amp;&amp;  ( PRIORVALUE(TSGADX__Inactive__c ) &lt;&gt; TSGADX__Inactive__c )  &amp;&amp; NOT(TSGADX__Inactive__c)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
