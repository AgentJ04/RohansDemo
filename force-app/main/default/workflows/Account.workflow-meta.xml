    <fieldUpdates>
        <fullName>TSGADX__Business_Billing_Zip_Code_Correction</fullName>
        <description>Update Billing Zip Code if it is missing leading zeros</description>
        <field>BillingPostalCode</field>
        <formula>IF(LEN(BillingPostalCode) = 1, &quot;0000&quot;&amp;BillingPostalCode, 
IF(LEN(BillingPostalCode) = 2, &quot;000&quot;&amp;BillingPostalCode, 
IF(LEN(BillingPostalCode) = 3, &quot;00&quot;&amp;BillingPostalCode, 
&quot;0&quot;&amp;BillingPostalCode)))</formula>
        <name>Business Billing Zip Code Correction</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>TSGADX__Business_Duns_Correction</fullName>
        <description>Update Duns with Leading Zeros</description>
        <field>TSGADX__Duns_No__c</field>
        <formula>IF (Len( TSGADX__Duns_No__c ) = 4 , &quot;00000&quot; &amp; TSGADX__Duns_No__c, 
IF (Len( TSGADX__Duns_No__c ) = 5 , &quot;0000&quot; &amp; TSGADX__Duns_No__c,
IF (Len( TSGADX__Duns_No__c ) = 6 , &quot;000&quot; &amp; TSGADX__Duns_No__c,
IF (Len( TSGADX__Duns_No__c ) = 7 , &quot;00&quot; &amp; TSGADX__Duns_No__c,
IF (Len( TSGADX__Duns_No__c ) = 8 , &quot;0&quot; &amp; TSGADX__Duns_No__c,
&quot;000000&quot; &amp; TSGADX__Duns_No__c)))))</formula>
        <name>Business Duns # Correction</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
