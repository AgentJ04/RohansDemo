        </actions>
        <active>true</active>
        <description>When a contact is marked as inactive, then check the email opt out.</description>
        <formula>$Setup.TSGADX__ADX_Settings__c.TSGADX__Enable_Workflow__c  &amp;&amp; TSGADX__Inactive__c</formula>
