    <rules>
        <fullName>TSGADX__Contact Call Back</fullName>
        <actions>
            <name>TSGADX__Call_Back_Customer</name>
            <type>Task</type>
        </actions>
        <active>true</active>
        <description>Create a task to call back customer.</description>
        <formula>$Setup.TSGADX__ADX_Settings__c.TSGADX__Enable_Workflow__c &amp;&amp;  (ISNEW() || ISCHANGED(TSGADX__Next_Call_Back__c)) &amp;&amp; NOT(ISBLANK( TSGADX__Next_Call_Back__c ))</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>TSGADX__Update Lead Source - Jigsaw</fullName>
        <actions>
            <name>TSGADX__Update_Lead_Source_Jigsaw</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>If the phone number starts with +1.&quot; update Lead Source field to Jigsaw</description>
        <formula>$Setup.TSGADX__ADX_Settings__c.TSGADX__Enable_Workflow__c &amp;&amp;   Left(Phone, 3)=&quot;+1.&quot;</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>TSGADX__Update Record Type%3A Blank</fullName>
        <actions>
            <name>TSGADX__Update_Blank_Record_Type</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description>Update Record Type to &quot;Customer/Prospect&quot; if the record type is Blank - this happens with NEW Jigsaw contacts.</description>
        <formula>$Setup.TSGADX__ADX_Settings__c.TSGADX__Enable_Workflow__c &amp;&amp; ISBLANK(RecordType.Name)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>TSGADX__Update Record Type%3A Competitor</fullName>
        <actions>
            <name>TSGADX__Update_Record_Type_to_Competitor</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <description>When the &quot;Type&quot; is changed - Update the Record Type to match.</description>
        <formula>$Setup.TSGADX__ADX_Settings__c.TSGADX__Enable_Workflow__c &amp;&amp;  ISCHANGED( TSGADX__Type__c ) &amp;&amp;  ISPICKVAL( TSGADX__Type__c , &quot;Competitor&quot;)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
